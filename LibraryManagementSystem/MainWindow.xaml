<Window x:Class="LibraryManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LibraryManagementSystem"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        >


    <Grid>
        <StackPanel Width="200"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <ComboBox x:Name="itemTypeComboBox" Height="30"
                  SelectionChanged="ComboBox_SelectionChanged">
                <ComboBoxItem>Book</ComboBoxItem>
                <ComboBoxItem>Magazine</ComboBoxItem>
                <ComboBoxItem>DVD</ComboBoxItem>
            </ComboBox>
            <Label Content="Title"/>

            <TextBox x:Name="titleTextBox"
                 Height="30"
                 Margin="0,10,0,0"/>
            
            <Label x:Name="detailsLabel" Content="Author"/>
            <TextBox x:Name="detailsTextBox"
                 Height="30"
                 Margin="0,10,0,0"/>

            <Button Content="Add"
        Height="30"
        Margin="0,10,0,0"
        Click="AddButton_Click"/>

        </StackPanel>
        <ListBox x:Name="itemsListBox"
         Width="250"
         Height="150"
         HorizontalAlignment="Right"
         VerticalAlignment="Center"/>
    </Grid>
</Window>
